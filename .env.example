# Reference only: the backend does not automatically load .env files.
# Export these variables in the shell before starting the API.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
# Optional SQLite URL; default is renewcred.db beside database.py.
# RENEWCRED_DATABASE_URL=sqlite:///./renewcred.db
# Reserved demo bridge metadata; setting this does not enable real chain writes.
EVM_RPC_URL=http://127.0.0.1:8545
